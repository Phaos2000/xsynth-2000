#include <windows.h>
#include "Version.h"
1 VERSIONINFO
 FILEVERSION XSYNTH_VERSION_NUMBERS
 PRODUCTVERSION XSYNTH_VERSION_NUMBERS
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", XSYNTH_VENDOR_NAME "\0"
   VALUE "FileDescription", XSYNTH_PRODUCT_NAME "\0"
   VALUE "FileVersion", XSYNTH_VERSION "\0"
   VALUE "ProductName", XSYNTH_PRODUCT_NAME "\0"
   VALUE "ProductVersion", XSYNTH_VERSION "\0"
   VALUE "OriginalFilename", XSYNTH_PRODUCT_NAME ".vst3\0"
   VALUE "LegalCopyright", "Original synthesizer (C) 1999 S. J. Brookes; Xsynth 2000 synthesizer (C) 2026 Phaos\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
